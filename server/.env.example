# Sunucuyu çalıştırmak için bu dosyayı kopyalayıp .env olarak kaydet:
#   cp .env.example .env
# Ardından değerleri kendi ortamına göre doldur.

# JWT imzalama anahtarı — güçlü, rastgele bir değer kullan
# Örnek: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=buraya_guclu_bir_rastgele_deger_yaz

# Sunucu portu (varsayılan: 9889)
PORT=9889

# CaYaDev OAuth entegrasyonu (opsiyonel)
CAYADEV_CLIENT_ID=
CAYADEV_CLIENT_SECRET=
CAYADEV_AUTH_URL=https://cayadev.com/oauth/authorize
CAYADEV_TOKEN_URL=https://cayadev.com/oauth/token
CAYADEV_USERINFO_URL=https://cayadev.com/oauth/userinfo
CAYADEV_REDIRECT_URI=https://app.cayadev.com/edebi-cengel-server/auth/cayadev/callback

# AI özelliği (true/false)
AI_ENABLED=true
